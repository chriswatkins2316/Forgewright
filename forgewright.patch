diff --git a/forge-gui-android/src/forge/app/DeckwrightActivity.java b/forge-gui-android/src/forge/app/DeckwrightActivity.java
new file mode 100644
index 0000000..68ceca4
--- /dev/null
+++ b/forge-gui-android/src/forge/app/DeckwrightActivity.java
@@ -0,0 +1,266 @@
+package forge.app;
+
+import android.Manifest;
+import android.annotation.SuppressLint;
+import android.app.Activity;
+import android.content.ActivityNotFoundException;
+import android.content.Intent;
+import android.content.pm.PackageManager;
+import android.net.Uri;
+import android.os.Bundle;
+import android.webkit.JavascriptInterface;
+import android.webkit.PermissionRequest;
+import android.webkit.ValueCallback;
+import android.webkit.WebChromeClient;
+import android.webkit.WebResourceRequest;
+import android.webkit.WebSettings;
+import android.webkit.WebView;
+import android.webkit.WebViewClient;
+import android.database.Cursor;
+import android.provider.OpenableColumns;
+import android.widget.Toast;
+
+import com.badlogic.gdx.Gdx;
+
+import java.io.ByteArrayOutputStream;
+import java.io.InputStream;
+import java.nio.charset.StandardCharsets;
+import java.util.Arrays;
+import java.util.List;
+import java.util.Map;
+
+import org.json.JSONObject;
+
+import forge.deck.Deck;
+import forge.deck.io.DeckSerializer;
+import forge.model.FModel;
+import forge.toolbox.FOptionPane;
+import forge.util.FileSection;
+import forge.util.storage.IStorage;
+
+/**
+ * Forgewright: shows the Deckwright web app inside Forge and lets it hand decks straight to Forge.
+ * Deckwright calls window.Forgewright.importDeck(name, dckText, kind) instead of copy and paste.
+ */
+public class DeckwrightActivity extends Activity {
+    public static final String DECKWRIGHT_URL = "https://chriswatkins2316.github.io/Deckwright/";
+    private static final int REQ_FILE = 4101, REQ_CAMERA = 4102;
+
+    private WebView web;
+    private ValueCallback<Uri[]> fileCallback;
+    private PermissionRequest pendingPermission;
+    private boolean pageReady;
+    private String sharedName, sharedText;   // a file shared to Forgewright, handed to Deckwright once the page has loaded
+
+    @SuppressLint("SetJavaScriptEnabled")
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        web = new WebView(this);
+        setContentView(web);
+
+        WebSettings s = web.getSettings();
+        s.setJavaScriptEnabled(true);
+        s.setDomStorageEnabled(true);
+        s.setDatabaseEnabled(true);
+        s.setMediaPlaybackRequiresUserGesture(false);
+        s.setAllowFileAccess(false);
+        s.setUserAgentString(s.getUserAgentString() + " Forgewright");
+
+        web.addJavascriptInterface(new Bridge(), "Forgewright");
+        web.setWebViewClient(new WebViewClient() {
+            @Override
+            public boolean shouldOverrideUrlLoading(WebView view, WebResourceRequest request) {
+                Uri u = request.getUrl();
+                String host = Uri.parse(DECKWRIGHT_URL).getHost();
+                if (host != null && host.equals(u.getHost())) return false;   // Deckwright itself stays inside
+                try { startActivity(new Intent(Intent.ACTION_VIEW, u)); } catch (ActivityNotFoundException ignored) { }
+                return true;                                                     // other links open in the browser
+            }
+
+            @Override
+            public void onPageFinished(WebView view, String url) {
+                pageReady = true;
+                deliverShared();
+            }
+        });
+        web.setWebChromeClient(new WebChromeClient() {
+            @Override
+            public void onPermissionRequest(final PermissionRequest request) {
+                runOnUiThread(() -> {
+                    boolean wantsCamera = Arrays.asList(request.getResources()).contains(PermissionRequest.RESOURCE_VIDEO_CAPTURE);
+                    if (wantsCamera && checkSelfPermission(Manifest.permission.CAMERA) != PackageManager.PERMISSION_GRANTED) {
+                        pendingPermission = request;
+                        requestPermissions(new String[]{ Manifest.permission.CAMERA }, REQ_CAMERA);
+                    } else {
+                        request.grant(request.getResources());
+                    }
+                });
+            }
+
+            @Override
+            public boolean onShowFileChooser(WebView view, ValueCallback<Uri[]> callback, FileChooserParams params) {
+                if (fileCallback != null) fileCallback.onReceiveValue(null);
+                fileCallback = callback;
+                try {
+                    startActivityForResult(params.createIntent(), REQ_FILE);
+                } catch (ActivityNotFoundException e) {
+                    try {
+                        Intent any = new Intent(Intent.ACTION_GET_CONTENT).addCategory(Intent.CATEGORY_OPENABLE).setType("*/*");
+                        startActivityForResult(any, REQ_FILE);
+                    } catch (ActivityNotFoundException e2) {
+                        fileCallback = null;
+                        return false;
+                    }
+                }
+                return true;
+            }
+        });
+
+        if (savedInstanceState != null) web.restoreState(savedInstanceState);
+        else web.loadUrl(DECKWRIGHT_URL);
+        readShared(getIntent());
+    }
+
+    @Override
+    protected void onNewIntent(Intent intent) {
+        super.onNewIntent(intent);
+        setIntent(intent);
+        readShared(intent);
+    }
+
+    /** A collection CSV shared to Forgewright ("Share" or "Open with" in another app): read it, then pass it to Deckwright. */
+    private void readShared(Intent intent) {
+        if (intent == null) return;
+        Uri uri = null;
+        if (Intent.ACTION_SEND.equals(intent.getAction())) uri = intent.getParcelableExtra(Intent.EXTRA_STREAM);
+        else if (Intent.ACTION_VIEW.equals(intent.getAction())) uri = intent.getData();
+        final Uri src = uri;
+        if (src == null) {
+            String text = intent.getStringExtra(Intent.EXTRA_TEXT);
+            if (text != null && !text.trim().isEmpty()) { sharedName = "shared text"; sharedText = text; deliverShared(); }
+            return;
+        }
+        new Thread(() -> {
+            String name = "shared file";
+            try (Cursor c = getContentResolver().query(src, new String[]{ OpenableColumns.DISPLAY_NAME }, null, null, null)) {
+                if (c != null && c.moveToFirst() && c.getString(0) != null) name = c.getString(0);
+            } catch (Exception ignored) { }
+            try (InputStream in = getContentResolver().openInputStream(src)) {
+                if (in == null) throw new IllegalStateException("no data");
+                ByteArrayOutputStream out = new ByteArrayOutputStream();
+                byte[] buf = new byte[65536];
+                int n, total = 0;
+                while ((n = in.read(buf)) > 0) {
+                    total += n;
+                    if (total > 25 * 1024 * 1024) throw new IllegalStateException("the file is too big");
+                    out.write(buf, 0, n);
+                }
+                final String fname = name, text = new String(out.toByteArray(), StandardCharsets.UTF_8);
+                runOnUiThread(() -> { sharedName = fname; sharedText = text; deliverShared(); });
+            } catch (Exception e) {
+                runOnUiThread(() -> Toast.makeText(this, "Couldn't read the shared file: " + e.getMessage(), Toast.LENGTH_LONG).show());
+            }
+        }).start();
+    }
+
+    private void deliverShared() {
+        if (!pageReady || web == null || sharedText == null) return;
+        String js = "window.deckwrightReceiveFile && window.deckwrightReceiveFile(" + JSONObject.quote(sharedName) + "," + JSONObject.quote(sharedText) + ")";
+        sharedName = null; sharedText = null;
+        web.evaluateJavascript(js, null);
+    }
+
+    @Override
+    protected void onActivityResult(int requestCode, int resultCode, Intent data) {
+        if (requestCode == REQ_FILE) {
+            if (fileCallback != null) fileCallback.onReceiveValue(WebChromeClient.FileChooserParams.parseResult(resultCode, data));
+            fileCallback = null;
+            return;
+        }
+        super.onActivityResult(requestCode, resultCode, data);
+    }
+
+    @Override
+    public void onRequestPermissionsResult(int requestCode, String[] permissions, int[] grantResults) {
+        if (requestCode == REQ_CAMERA && pendingPermission != null) {
+            if (grantResults.length > 0 && grantResults[0] == PackageManager.PERMISSION_GRANTED) pendingPermission.grant(pendingPermission.getResources());
+            else pendingPermission.deny();
+            pendingPermission = null;
+            return;
+        }
+        super.onRequestPermissionsResult(requestCode, permissions, grantResults);
+    }
+
+    @Override
+    public void onBackPressed() {
+        if (web != null && web.canGoBack()) web.goBack();
+        else backToForge();
+    }
+
+    /**
+     * Forge's main screen runs in its own task (launchMode singleInstance), so this screen sits in a separate task.
+     * Finishing it alone would drop to the phone's home screen, so bring Forge to the front first.
+     */
+    private void backToForge() {
+        try {
+            Intent forge = new Intent(this, Main.class);
+            forge.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK | Intent.FLAG_ACTIVITY_REORDER_TO_FRONT);
+            startActivity(forge);
+        } catch (Exception e) {
+            e.printStackTrace();
+        }
+        finish();
+    }
+
+    @Override
+    protected void onSaveInstanceState(Bundle outState) {
+        super.onSaveInstanceState(outState);
+        if (web != null) web.saveState(outState);
+    }
+
+    @Override
+    protected void onDestroy() {
+        if (web != null) { web.destroy(); web = null; }
+        super.onDestroy();
+    }
+
+    /** What Deckwright's page can call, as window.Forgewright.* */
+    private class Bridge {
+        @JavascriptInterface
+        public String version() { return "1"; }
+
+        /**
+         * Adds a deck to Forge and returns to Forge.
+         * kind: "commander" (Commander and Historic Brawl), "brawl" (Standard Brawl) or "constructed".
+         */
+        @JavascriptInterface
+        public void importDeck(final String name, final String dckText, final String kind) {
+            final List<String> lines = Arrays.asList(String.valueOf(dckText).split("\\r?\\n"));
+            Gdx.app.postRunnable(() -> {
+                try {
+                    Map<String, List<String>> sections = FileSection.parseSections(lines);
+                    Deck deck = DeckSerializer.fromSections(sections);
+                    if (deck == null) throw new IllegalArgumentException("the deck list couldn't be read");
+                    IStorage<Deck> storage;
+                    String where;
+                    if ("commander".equals(kind)) { storage = FModel.getDecks().getCommander(); where = "Commander"; }
+                    else if ("brawl".equals(kind)) { storage = FModel.getDecks().getBrawl(); where = "Brawl"; }
+                    else { storage = FModel.getDecks().getConstructed(); where = "Constructed"; }
+                    storage.add(deck);
+                    FOptionPane.showMessageDialog("\"" + deck.getName() + "\" is in Deck Manager, under " + where + " decks. Pick it when you start a "
+                            + where + " game.", "Added from Deckwright");
+                } catch (Exception e) {
+                    FOptionPane.showErrorDialog("Couldn't add the deck from Deckwright: " + e.getMessage());
+                }
+            });
+            runOnUiThread(() -> {
+                Toast.makeText(DeckwrightActivity.this, "Sending " + name + " to Forge…", Toast.LENGTH_SHORT).show();
+                backToForge();   // back to Forge, where the deck has just been added
+            });
+        }
+
+        @JavascriptInterface
+        public void close() { runOnUiThread(DeckwrightActivity.this::backToForge); }
+    }
+}
